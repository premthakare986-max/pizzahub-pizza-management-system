# ============================================================================
# PIZZAHUB - MYSQL 8.0+ BACKEND CONFIGURATION
# ============================================================================
# IMPORTANT:
# - When running locally on your MacBook (Homebrew MySQL 8 / XAMPP / MySQL.prefPane),
#   set DB_HOST=127.0.0.1 and your local MySQL root/user credentials.
# - When running inside Google AI Studio Cloud Preview, 127.0.0.1 is the cloud
#   container (NOT your MacBook). You must provide a remotely accessible MySQL 8
#   hostname (e.g. Aiven MySQL, Railway MySQL, AWS RDS, PlanetScale, or Cloud SQL).

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=pizzahub_db

# JWT Secret for Backend Token Signing
JWT_SECRET=pizzahub_super_secret_jwt_key_2026_dbms_project

# Express Server Port
PORT=3000

# AI Studio Runtime Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
